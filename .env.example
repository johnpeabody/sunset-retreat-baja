# ── Booking ────────────────────────────────────────────────
# "mock" (default) = built-in preview widget, no payments.
# "live" = paste the Lodgify booking embed into components/BookingWidget.tsx.
NEXT_PUBLIC_BOOKING_MODE=mock

# ── For-sale page (unlisted) ───────────────────────────────
# Secret slug. The page lives at /sale/<this value>. Share via URL + QR only.
SALE_PAGE_TOKEN=casa-sosiego-7f3a9c

# ── Lead notifications (Resend) ────────────────────────────
# Sign up at resend.com, create an API key. Until set, inquiries are logged
# to the server console only.
RESEND_API_KEY=
OWNER_EMAIL=                       # friend's email — where leads land
MAIL_FROM=Sunset Retreat <onboarding@resend.dev>

# ── Lead storage (Google Sheet) ────────────────────────────
# Easiest path (no OAuth): in the target Sheet, Extensions → Apps Script,
# paste a doPost(e) that appends JSON.parse(e.postData.contents) as a row,
# Deploy → Web app (Anyone), and put the resulting /exec URL here.
GOOGLE_SHEETS_WEBHOOK_URL=
